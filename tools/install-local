#!/usr/bin/env bash
# install-local — copy this working tree into ~/.config/omarchy/plugins/ and run it
#
# Usage:
#   tools/install-local              # sync (the shell hot-reloads plugin code)
#   tools/install-local --restart    # sync, then restart the shell
#
# Omarchy rejects symlinks inside the plugin folder (`omarchy plugin validate`
# fails on them), so this copies the files instead of linking them.
set -euo pipefail

PLUGIN_ID="io.github.polidog.abematv"
SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME:?HOME is not set}/.config}"
PLUGINS_DIR="$CONFIG_HOME/omarchy/plugins"
DEST="$PLUGINS_DIR/$PLUGIN_ID"

# rsync --delete empties whatever it is aimed at, so verify the target before
# aiming it: an absolute plugins directory, a folder named for this plugin, and
# — if something is already there — this plugin's own manifest rather than a
# neighbour's. A relative XDG_CONFIG_HOME or a hand-edited PLUGIN_ID would
# otherwise have this deleting a directory nobody meant to hand over.
if [[ "$CONFIG_HOME" != /* ]]; then
  echo "install-local: XDG_CONFIG_HOME must be an absolute path, got '$CONFIG_HOME'" >&2
  exit 1
fi

if [[ "$(dirname "$DEST")" != "$PLUGINS_DIR" || "$(basename "$DEST")" != "$PLUGIN_ID" ]]; then
  echo "install-local: refusing to sync to $DEST" >&2
  exit 1
fi

if [[ ! -f "$SRC/manifest.json" ]]; then
  echo "install-local: $SRC has no manifest.json, nothing to install" >&2
  exit 1
fi

if [[ -L "$DEST" ]]; then
  echo "install-local: $DEST is a symlink, removing it" >&2
  rm "$DEST"
elif [[ -e "$DEST" && ! -d "$DEST" ]]; then
  echo "install-local: $DEST exists and is not a directory" >&2
  exit 1
elif [[ -f "$DEST/manifest.json" ]] &&
     ! grep -q "\"id\"[[:space:]]*:[[:space:]]*\"$PLUGIN_ID\"" "$DEST/manifest.json"; then
  echo "install-local: $DEST holds a different plugin, refusing to delete it" >&2
  exit 1
fi

mkdir -p "$DEST"
rsync -a --delete \
  --exclude '.git/' \
  --exclude 'preview.png' \
  --exclude 'README.ja.md' \
  "$SRC/" "$DEST/"

echo "install-local: $SRC -> $DEST"

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$DEST" >/dev/null && echo "install-local: validate ok"
fi

if [[ "${1:-}" == "--restart" ]]; then
  omarchy-restart-shell >/dev/null 2>&1 || true
  for _ in $(seq 1 20); do
    sleep 1
    if omarchy-shell shell ping 2>/dev/null | grep -q ok; then
      echo "install-local: shell restarted"
      exit 0
    fi
  done
  echo "install-local: the shell is not answering" >&2
  exit 1
fi
